DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cosine similarity threshold for face compare at check-in/out (0.0..1.0).
FACE_SIMILARITY_THRESHOLD=0.7

# Firebase Cloud Messaging (push notifications). Set this to the base64
# encoding of the Firebase service-account JSON file:
#   base64 < firebase-service-account.json | tr -d '\n'
# Leave empty to disable push (announcements still save; broadcast no-ops).
FIREBASE_SA_JSON_BASE64=
